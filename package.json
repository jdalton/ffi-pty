{
  "name": "ffi-pty",
  "version": "0.0.0",
  "private": true,
  "description": "Pseudoterminals for Node.js using built-in FFI, with no runtime dependencies",
  "files": [
    "dist/**/*.mjs",
    "dist/types/**",
    "dist/bin/**",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compat": {
      "types": "./dist/types/compat-index.d.mts",
      "default": "./dist/compat.mjs"
    },
    "./spawn": {
      "types": "./dist/types/pty.d.mts",
      "default": "./dist/pty.mjs"
    },
    "./open": {
      "types": "./dist/types/unix-open.d.mts",
      "default": "./dist/unix-open.mjs"
    }
  },
  "scripts": {
    "build:windows-helper": "node src/win32/build-windows-helper.mts",
    "format": "node scripts/fmt/index.mts",
    "format:check": "node scripts/check/format.mts",
    "lint": "node scripts/lint/index.mts",
    "probe": "node --experimental-ffi src/probe.mts",
    "test": "node scripts/test.mts fast",
    "test:vitest": "node scripts/test.mts unit",
    "check": "node scripts/check/index.mts",
    "build": "node scripts/build.mts",
    "prepack": "pnpm run build",
    "test:build": "pnpm run build && node scripts/test.mts tooling && node --test .config/rolldown/tests/*.test.mts",
    "setup": "node scripts/setup.mts",
    "prepare": "pnpm run setup",
    "check:policy": "node scripts/check/policy.mts",
    "pack": "pnpm run build && pnpm --dir dist pack --pack-destination ../artifacts",
    "coverage:collect": "node .config/coverage/collect.mts",
    "coverage:check": "node .config/coverage/gate.mts",
    "test:integration": "node scripts/test.mts integration",
    "test:mid": "node scripts/test.mts mid",
    "test:slow": "node scripts/test.mts slow",
    "test:all": "pnpm test && pnpm run test:mid && pnpm run test:slow",
    "update": "node scripts/update/index.mts",
    "upstream:sync": "node scripts/sync-upstream.mts",
    "fix": "node scripts/fix/index.mts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "c8": "12.0.0",
    "istanbul-lib-coverage": "3.2.2",
    "nock": "15.0.6",
    "oxfmt": "0.66.0",
    "oxlint": "1.93.0",
    "rolldown": "1.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "packageManager": "pnpm@12.12.0"
}
